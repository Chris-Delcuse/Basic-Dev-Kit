PwdGUI()
Prgm

ClrErr

setFold(pwd)

Local tp,dg,lst,dgl,typ
Local dgt,digits, sv, nm
Local idt, rwa

0→digits:0→tp:0→dg:{}→lst
0→sv:""→nm:""→idt:{}→rwa
{" Numeric"," Digicode"," Alpha-Num"," Sp-αNum"}→typ

Lbl start
Dialog
Title "🔓 PwDGeN 🔓"
Text "Choose Password type :"
DropDown "PwD Type :",typ,tp
Text ""
EndDlog
If ok=0:Goto quit

If tp=1 Then
{"  4 Digits","  6 Digits","  8 Digits"," 16 Digits"," 32 Digs"}→lst
ElseIf tp=2 Then
{"  5 Digits","  6 Digits"}→lst
Else
{"  8 Digits"," 10 Digits"," 12 Digits"," 14 Digits"," 16 Digits"}→lst
EndIf

Dialog
Title "🔓 PwDGeN 🔓"
Text "Choose Digits :"
DropDown "Digits :",lst,dg
Text ""
EndDlog
If ok=0:Goto start

1→digits
expr(lst[dg])→dgt

pwdgen(tp,dgt)



Lbl quit
setFold(main)
EndPrgm
